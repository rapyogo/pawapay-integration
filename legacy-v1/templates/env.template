# === pawaPay — configuration .env ===
# Copier ce fichier en .env et remplir les vraies valeurs.
# NE JAMAIS committer le .env réel — seul ce .env.example doit être versionné.

# Environnement actif : sandbox ou production
# Détermine quel PAWAPAY_BASE_URL et quel PAWAPAY_API_TOKEN sont utilisés par le code.
PAWAPAY_ENV=sandbox

# URL de base de l'API.
# Provenance : fixe, documentée par pawaPay (pas la même chose que le Dashboard).
# Sandbox   : https://api.sandbox.pawapay.io/
# Production: https://api.pawapay.io/
PAWAPAY_BASE_URL_SANDBOX=https://api.sandbox.pawapay.io/
PAWAPAY_BASE_URL_PRODUCTION=https://api.pawapay.io/

# Token d'authentification (Bearer).
# Provenance : généré depuis le Dashboard pawaPay (dashboard.sandbox.pawapay.io ou
# dashboard.pawapay.io selon l'environnement). Un token sandbox ne fonctionne PAS en production
# et inversement — ce sont deux comptes/dashboards distincts.
# Règle de sécurité : jamais dans le code, jamais loggé, jamais dans un repo public.
PAWAPAY_API_TOKEN_SANDBOX=
PAWAPAY_API_TOKEN_PRODUCTION=

# Clé privée pour signer les requêtes sortantes (deposits/payouts/refunds) — OPTIONNEL mais
# recommandé. Provenance : générée par vous (ECDSA P-256 recommandé), la clé publique
# correspondante est uploadée dans le Dashboard pawaPay. Une paire différente par environnement.
# Exemple de valeur : chemin vers un fichier, PAS la clé en clair dans ce fichier si possible.
PAWAPAY_SIGNING_PRIVATE_KEY_PATH=
PAWAPAY_SIGNING_KEY_ID=

# Pays et devise par défaut de votre activité — sert à valider les correspondents autorisés
# côté code avant même d'appeler l'API (évite un aller-retour réseau pour une erreur évidente).
# Exemple RDC :
PAWAPAY_DEFAULT_COUNTRY=COD
PAWAPAY_DEFAULT_CURRENCY=USD

# URL publique où pawaPay enverra les callbacks (deposit/payout/refund status).
# IMPORTANT : ce n'est PAS une variable que l'API pawaPay lit — elle doit être configurée
# manuellement dans le Dashboard pawaPay (Settings > Callback URLs). Cette variable ici sert
# uniquement à ce que VOTRE code sache quelle route exposer et documenter.
PAWAPAY_CALLBACK_URL=https://votre-domaine.com/webhooks/pawapay

# Secret utilisé pour signer les callbacks (uniquement si vous générez le vôtre côté app pour
# un usage interne — ne pas confondre avec la vérification de signature RFC-9421 de pawaPay,
# qui utilise leur clé publique récupérée via l'endpoint Public Keys, pas un secret partagé).
# Laisser vide si non utilisé.
INTERNAL_WEBHOOK_VERIFICATION_NOTE="Vérification pawaPay = RFC-9421 avec leur clé publique, pas un secret partagé classique"
